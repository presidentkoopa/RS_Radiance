server float rsf_outdoor = 1.0;

// ================= RS_Sweeps =================
// RS_Sweeps -- CVars
//
// Bands of light travelling through the world, tested per pixel against world
// position on every surface -- so one band wraps across floor, wall and ceiling
// as a single unbroken line. Nothing per-sector can do that: a sector's glow is
// uniform across that sector, this is per-pixel in world space.
//
// The engine has carried this for a long time with one caller: the weapon
// wheel, using one band out of eight as an expanding ring. Bands 1-7, the
// trail, the per-band shapes, the draw modes and the whole lattice had never
// been driven by anything.

server bool  rss_enabled       = true;
server int   rss_preset        = 1;

// A SWEEP shape (6-9) always crosses the whole map, whatever "Centred on"
// says. Owner 2026-09-18: "evertyhing crosses the map, nothing originates from
// player" -- and a sweep starting at your feet while the menu also offered a
// crossing shape was the contradiction they were seeing.
//
// Off restores the old reading, where Follows you starts the front where you
// stand and sends it outward. Rings, bars and shells are not affected either
// way: they have no edge to leave from, so they always use Centred on.
server bool  rss_cross_always  = true;

// Internal. The preset last applied, so a preset only re-applies when it
// CHANGES rather than on every map load, which would wipe slider tweaks.
//
// NOSAVE, NOT SERVER, and the distinction is load-bearing -- see the same note
// in RS_GlowInTheDark and RS_Darkness. A server cvar is not written locally
// when you set it; the write is queued to the network and only lands after it
// round-trips, so a latch read back on the next tic still reads its old value
// and the whole preset re-applies. That compounds until the tic's net buffer
// overflows.
nosave int   rss_preset_applied = -1;

// ------------------------------------------------------------- what fires --
//
// Three independent sources, because they are three different feelings and
// nothing says you want only one. Ambient is the room having weather. Events
// are the world answering you. Ping is equipment you are carrying.
//
// They share the eight band slots: ambient takes the low slots, events claim
// from the top down, and the ping takes one. Running all three at once with a
// high ambient count will starve the events -- the menu says so.

server bool  rss_ambient       = true;
server int   rss_ambient_count = 2;
server float rss_ambient_speed = 0.35;   // cycles per second
server float rss_ambient_reach = 900.0;  // how far a band travels; the sweeps take the map's own
server int   rss_ambient_shape = 1;      // 1 ring, 2 bars along X, 3 bars along Y, 4 shell, 5 rising plane, 6-9 sweep toward +X +Y -X -Y
server int   rss_ambient_org   = 1;      // 0 map origin, 1 follows you, 2 fixed below, 3 map centre

server float rss_ambient_x     = 0.0;
server float rss_ambient_y     = 0.0;
server float rss_ambient_z     = 0.0;

// HOW THE STANDING BANDS ARE SPACED.
//
// 0 SPREAD: the bands share one cycle and sit evenly round it, so there is
// always one somewhere between you and the reach. rss_ambient_speed is in
// cycles a second.
//
// 1 TRAIN: one clock in map units a second, and each band leaves a fixed number
// of tics after the one before. The cycle restarts only once the LAST band has
// covered the reach, so no band vanishes mid-room because its leader ran out of
// travel. This is GlowInTheDark's sweep timing, carried over whole so that its
// Neon Unison band could come with it.
//
// 2 ONCE: one pass, then nothing until it is sent again -- by a new map, or by
// the rss_sweep network event (bound as rss_sweep_now in KEYCONF). A pass
// takes 1/speed seconds and the bands leave the same fraction apart Spread
// uses. The only standing timing that runs the Effects: a looping band would
// re-apply them every cycle.
server int   rss_ambient_timing = 0;
server float rss_train_speed    = 128.0;  // map units a second
server int   rss_train_gap      = 140;    // tics between one band leaving and the next

// A ping from you. One band, restarting on an interval rather than cycling
// continuously, so it reads as a device rather than as the room.
server bool  rss_ping          = false;
server float rss_ping_every    = 3.0;    // seconds between pings, or longer if it is still travelling
server float rss_ping_speed    = 1.1;    // 1 crosses the reach in exactly the interval
server float rss_ping_reach    = 1100.0;

// The world answering. Each of these spawns a band at the thing that happened.
server bool  rss_ev_kill       = true;
server bool  rss_ev_explode    = true;
server bool  rss_ev_hurt       = false;  // when YOU take damage
server float rss_ev_life       = 1.1;    // seconds a fired band lives, at speed 1
server float rss_ev_reach      = 700.0;  // how far it travels; the sweeps take the map's own
server float rss_ev_speed      = 1.0;    // divides the life: the band always travels its reach
server int   rss_ev_shape      = 1;
server int   rss_ev_slots      = 4;      // how many of the eight events may hold

// ---------------------------------------------------------------- the band --

server float rss_thickness     = 26.0;   // world units of full strength
server float rss_softness      = 0.55;   // falloff exponent past the thickness
server float rss_intensity     = 1.30;
// Wake, in map units, signed; 0 = symmetric. The shader only stretches a band
// when this is LONGER than the band's thickness -- shorter, and it stays
// symmetric. See SweepBandAttenAt in main.fp.
server float rss_trail         = 0.0;
server int   rss_draw          = 1;      // 1 add, 2 lift, 3 crush, 4 recolour the glow it covers

// Fade out as the band reaches the end of its travel, so it does not simply
// stop existing at full brightness.
server float rss_fade          = 0.35;   // fraction of the life spent fading

// -------------------------------------------------------------- the colour --

server int   rss_col_r         = 120;
server int   rss_col_g         = 200;
server int   rss_col_b         = 255;

// A second colour the band crosses into as it travels. Mix 0 = one colour.
server float rss_col_mix       = 0.0;
server int   rss_col2_r        = 255;
server int   rss_col2_g        = 90;
server int   rss_col2_b        = 160;

// ------------------------------------------------------------- each band --
//
// Off, every standing band wears the one colour, thickness and draw mode above.
// On, standing band N takes its own from here -- which is what lets a train be
// a bar of music rather than eight copies of one note: a wide downbeat, narrow
// ticks, one band that crushes instead of adding.
//
// Thickness and draw 0 mean "use the shared value", so a table that only wants
// its own colours says nothing else. Fired bands and the ping always use the
// shared values; this table is for the standing bands.
//
// The colours default to Neon Unison's arch -- near white, down through gold
// to deep orange at band 4, and back up to cream at band 8.
server bool  rss_perband       = false;
server color rss_band_col1     = "ff f2 d8";
server color rss_band_col2     = "ff c2 4a";
server color rss_band_col3     = "ff a0 20";
server color rss_band_col4     = "ff 7a 12";
server color rss_band_col5     = "07 13 1c";
server color rss_band_col6     = "ff 8c 1e";
server color rss_band_col7     = "ff b4 3a";
server color rss_band_col8     = "ff d8 6e";
server int   rss_band_thick1   = 0;
server int   rss_band_thick2   = 0;
server int   rss_band_thick3   = 0;
server int   rss_band_thick4   = 0;
server int   rss_band_thick5   = 0;
server int   rss_band_thick6   = 0;
server int   rss_band_thick7   = 0;
server int   rss_band_thick8   = 0;
server int   rss_band_draw1    = 0;
server int   rss_band_draw2    = 0;
server int   rss_band_draw3    = 0;
server int   rss_band_draw4    = 0;
server int   rss_band_draw5    = 0;
server int   rss_band_draw6    = 0;
server int   rss_band_draw7    = 0;
server int   rss_band_draw8    = 0;

// --------------------------------------------------------------- lattice --
//
// The pattern drawn INSIDE a band. The band's own colour is the field, this
// colour is the lines, and spacing 0 in an axis means no lines in that axis --
// so a grid, slats and a single tripwire are all one mode.
//
// AIR is the part nothing else in this family can do. At 0 the lattice is
// painted onto whatever surfaces the band lands on; above 0 it also hangs in
// the air, so you walk through a grid of light rather than looking at one.
// It costs more per fragment inside a band, which is why the quiet presets
// leave it at 0.

server int   rss_fill          = 0;      // 0 none, 1 grid, 2 dots, 3 solid slab
server float rss_fill_u        = 48.0;   // spacing across, world units
server float rss_fill_v        = 48.0;   // spacing up
server float rss_fill_width    = 3.0;
server float rss_fill_soft     = 1.5;
server float rss_fill_gap      = 0.35;   // how lit the space between lines is
server float rss_fill_air      = 0.0;

server int   rss_fill_r        = 255;
server int   rss_fill_g        = 255;
server int   rss_fill_b        = 255;

// How the lattice moves within the band. Rotate is degrees, drift slides it
// along, major thickens every Nth line, jitter and flicker are the two ways of
// making it look driven rather than drawn.
server float rss_fill_rotate   = 0.0;
server float rss_fill_drift    = 0.0;
server float rss_fill_major    = 0.0;
server float rss_fill_boost    = 2.0;
server float rss_fill_jitter   = 0.0;
server float rss_fill_flicker  = 0.0;
server float rss_fill_grad     = 0.0;
server int   rss_fill_grad_axis = 0;

// ------------------------------------------------- what a sweep DOES to it --
//
// The frontier can act on what it passes. Everything here is off by default:
// a sweep is a light until you ask it to be more than that.

server bool  rss_fx           = false;   // master switch for all of it
server bool  rss_fx_sectors   = true;    // test sectors as the front passes
server bool  rss_fx_actors    = true;    // test actors

// THE RETIER. Triggers RS_MonsterMaster's staggered neutral/glow/neutral
// sequence on monsters the front reaches. Step is signed, so a sweep can tier
// DOWN as readily as up. Vanilla monsters have no ladder and are skipped.
server bool  rss_fx_tier      = false;
server int   rss_fx_tier_step = 1;

server bool  rss_fx_fog       = false;
server float rss_fx_fog_radius   = 160.0;
server float rss_fx_fog_strength = 0.7;
server float rss_fx_fog_speed    = 200.0;
server float rss_fx_fog_life     = 0.8;

server bool  rss_fx_recolour  = false;
server float rss_fx_recolour_reach = 140.0;

server bool  rss_fx_rouse     = false;

// Which tier a sweep sets. TRUE means the sweep's own colour picks the rung --
// a blue sweep makes blue monsters, the same band that turned the fog blue.
// FALSE falls back to the signed step above, for a sweep that should promote or
// demote whatever it finds regardless of colour.
server bool  rss_fx_tier_bycolour = true;

// Call Actor.OnSweepCrossed on what the front reaches. On by default, but
// skipped entirely when nothing that overrides the hook is loaded -- otherwise
// a sweep with no monster mod present would walk every actor in the level to
// call an empty function on each. Force it on if some OTHER mod overrides the
// hook and RS_Sweeps has no way to know.
server bool  rss_fx_crossed        = true;
server bool  rss_fx_crossed_always = false;

// ---- glow ----
server bool  rss_fx_glow       = false;
server float rss_fx_glow_wall  = 96.0;    // how far the wall glow reaches, 0 = leave walls
server float rss_fx_glow_flat  = 140.0;   // the flat-edge glow, 0 = leave flats

// ---- sector light ----
server bool  rss_fx_light      = false;
server int   rss_fx_light_step = -32;     // signed: negative puts rooms out
server int   rss_fx_light_floor = 0;
server int   rss_fx_light_ceil  = 255;

// ---- fog colour ----
// Written through RS_Fog's nosave rsf_tint_r/g/b and rsf_tint_mix, which it
// pushes in place of its own gradient while the mix is above 0. A direct
// SetFogGradient was put back by RS_Fog's own push before a frame was drawn.
// The mix returns to 0 when the last band ends and at every map change.
server bool  rss_fx_fogtint     = false;
server float rss_fx_fogtint_mix = 0.7;

// ---- darkness ----
// Written through RS_Darkness's nosave rsd_sweep_offset, which it adds on top
// of rsd_adjust -- never through rsd_adjust itself, a server cvar and the
// player's own saved Amount, which a sweep used to change for good. Published
// at most once a tic, back to 0 when the last band ends and at every map
// change. An RS_Darkness without the offset cvar is treated as absent. The
// limits are on where the darkness ends up, in rsd_adjust units.
server bool  rss_fx_dark      = false;
server float rss_fx_dark_step = 8.0;      // signed
server float rss_fx_dark_min  = 0.0;
server float rss_fx_dark_max  = 224.0;

// ---- colour drain ----
server bool  rss_fx_desat       = false;
server float rss_fx_desat_step  = 0.05;
server bool  rss_fx_desat_reset = true;   // put it back when the last band ends (a map change always does)

// ---- decorations ----
server bool  rss_fx_decor           = false;
server bool  rss_fx_decor_monsters  = false;
server float rss_fx_decor_strength  = 0.8;
server float rss_fx_decor_thickness = 1.2;
server float rss_fx_decor_threshold = 0.2;
server float rss_fx_decor_glow      = 2.5;

// ------------------------------------------------------- behind the line --
//
// THE AFTER-LOOK. Everything a band's front has already crossed is graded per
// pixel -- tinted, darkened, drained -- so the change follows the line exactly
// rather than flipping a room when its centre is crossed. The per-sector
// Effects above still do that, and still carry the gameplay; this is only the
// picture.
//
// Standing bands on Once timing and fired bands. Never a looping band, which
// would grade its whole reach and snap back every cycle. A Once pass that
// arrives leaves one band parked past the far edge at brightness 0, so the
// look stays for the rest of the map until the next pass is sent. A fired band
// keeps it only while it lives.
//
// One look shared by every passed band. The engine grades the room's own light
// only: glow, the bands, beams and fullbright things keep their colour. Off by
// default.
server bool  rss_after         = false;
server int   rss_after_r       = 140;
server int   rss_after_g       = 160;
server int   rss_after_b       = 220;
server float rss_after_mix     = 0.5;    // how far the light is multiplied toward the tint
server float rss_after_darken  = 0.3;    // how much light is taken away
server float rss_after_desat   = 0.6;    // how much colour is drained
server float rss_after_soft    = 128.0;  // map units the look fades in over behind the front

// ---- which kills are worth a sweep ----
//
// Empty class name means any monster. Naming one catches that class and
// everything descended from it, so one entry covers every colour of a family.
server string rss_ev_class     = "";

// Only monsters at or above this tier. Read as an inventory count, so it needs
// no reference to the monster mod at all and is simply 0 when it is absent --
// which means any floor above 0 also means "only tiered monsters". It counts
// RS_ZomTierToken only: RS_MonsterMaster keeps its tier in a field and gives no
// token, so those monsters never pass a floor above 0 until RS_Main mirrors it.
server int    rss_ev_tier_min  = 0;

// Bosses only. Counts three things that do not agree with each other: the BOSS
// flag, the BOSSDEATH flag, and sheer size -- a colour-tier boss is often
// neither flagged nor scripted and is just enormous. 0 health disables the
// size test.
server bool   rss_ev_bossonly    = false;
server int    rss_ev_boss_health = 1500;

// ================= RS_Bloom =================
// RS_Bloom -- CVars
//
// WHY THIS MOD EXISTS.
//
// Bloom is what turns an over-bright pixel into a glow. Every emissive thing in
// this family deliberately writes past 1.0 for exactly that reason -- the neon
// core at 2.6, the white cores in the surface stamps, a wall of light at 2.6
// intensity. None of that reads as LIGHT until bloom picks it up; without it
// they are just pale pixels.
//
// The engine already had the controls, including this fork's own additions --
// a lowerable threshold, a soft knee, anamorphic streaking, a bloom tint and
// chromatic fringing. Not one of them appeared in any menu in this family, so
// the single setting the whole lighting set depends on was whatever it happened
// to be, adjustable only from the console.
//
// EVERY SLIDER HERE DRIVES AN ENGINE gl_bloom_* / gl_exposure_* CVAR DIRECTLY.
// This mod adds no render state of its own -- it is a menu and a set of presets
// for controls that already existed. That is deliberate: bloom is global, one
// pass, shared by every mod, and a second copy of it would be a second thing to
// keep in step.
//
// NOSAVE, ALL THREE. These are this machine's display preferences, like the
// gl_bloom_* cvars they drive. As server cvars they rode along in savegames, so
// loading a save made under another preset changed rsb_preset and stamped that
// preset over the player's own bloom settings.

nosave bool rsb_enabled = true;
// -1 = None: leave bloom as it is. Any preset changes the grab laser and Lance
// glow (they are tuned to the engine's threshold), so nothing applies until a
// preset is picked.
nosave int  rsb_preset  = -1;

// Internal: the preset last applied, so it only re-applies when it changes. The
// "Re-apply preset" row sets this to -1 to stamp the current preset again after
// tuning by hand.
nosave int  rsb_preset_applied = -1;

// ---- BLOOM THAT REACTS (zscript/rsb_reactive.zs) ---------------------------
//
// NOSAVE like the rest: display preferences for this machine.
//
// The master starts OFF: every reaction changes how the grab lasers and the
// Lance glow while it lasts, so it waits for the owner's A/B. The effects under
// it start on, so the one switch brings them all in.
nosave bool rsb_reactive    = false;
nosave bool rsb_rx_flash    = true;
nosave bool rsb_rx_breathe  = true;
nosave bool rsb_rx_sweep    = true;
nosave bool rsb_rx_hurt     = true;
// Follow the dark moves the threshold all the time rather than for a moment,
// so it changes the laser glow continuously. Off until the laser exclusion.
nosave bool rsb_rx_dark     = false;

// ================= RS_Flashlight =================
// RS_Flashlight -- CVars
//
// A cone of lit AIR rather than a lit disc on the wall. Raymarched as a
// postprocess pass, bounded first by an analytic ray/cone intersection so a
// beam pointing away from you costs a depth sample and a few dot products.
//
// The ON/OFF is deliberately NOT here. It is an inventory token, because a cvar
// lives on one machine and nobody else's client would know your torch was lit.

// The whole mod, on or off. The host's call, so it stays server.
server bool  rsfl_enabled     = true;

// EVERYTHING BELOW IS `user`, NOT `server`.
//
// Where the torch sits and what the beam looks like change only what THIS
// machine draws -- the beam is published for the console player alone. As
// server cvars they were the host's to set, so in a netgame nobody else could
// pick their own mount or colour.

// Where the torch is held. The engine reads the pose every FRAME
// (SetVolumetricBeamAnchor), so a hand torch does not judder behind the
// controller the way a pose published at 35 Hz did.
//   0 head    -- the headset, or the view on a flat screen
//   1 off hand
//   2 the weapon hand
//
// The off hand is the one worth having in VR: you can light a doorway while
// aiming somewhere else. Head-mounted always points where you already look, and
// a cone seen end-on is a disc -- the engine fades that case (vol_beam_axisfade).
user int   rsfl_mount       = 1;

// Where on the mount the lens is, in map units, in the MOUNT'S OWN frame: they
// turn with the hand or head, so "forward" stays along the beam however you
// hold it.
user float rsfl_offset_fwd  = 0.0;
user float rsfl_offset_side = 0.0;    // + right
user float rsfl_offset_z    = -4.0;   // + up

// ------------------------------------------------------------------ shape --
user float rsfl_inner       = 11.0;    // degrees, full brightness inside
user float rsfl_outer       = 26.0;    // degrees, faded to nothing by here
user float rsfl_length      = 1400.0;
user float rsfl_density     = 0.5;

// ---- weight and sway -------------------------------------------------------
//
// A torch welded to your hand reads as a torch painted on the screen. Weight makes it trail
// the hand; sway hangs it below on a spring so it swings and settles, which is what anything
// held by a handle does.
//
// Both zero is welded, which is how it has always been. Set on the ANCHOR, so the cone and
// the light it casts on the wall move together -- a cone that lags while its own light does
// not is worse than no lag.
user float rsfl_weight      = 0.0;   // seconds to close most of the gap (0 to 2)
user float rsfl_sway        = 0.0;   // how far it hangs and swings (0 to 4)
user float rsfl_sway_damp   = 0.5;   // 0 floppy, 1 stiff
// Above 1 concentrates the light near the lens, which is what stops a long
// beam looking like a strip light.
user float rsfl_falloff     = 1.8;

// ------------------------------------------------------------------- spot --
// The light the torch throws on walls, floors and monsters: a real dynamic
// spot light on the pawn, shaped by the cone above -- same angles, same colour,
// and it dies out where the beam's reach does. This is its brightness. 0 takes
// the light off entirely and leaves only the lit air, exactly as before.
//
// It does not flicker. rsfl_flicker moves every tic, and following it would
// rebuild the pawn's lights 35 times a second.
user float rsfl_spot        = 1.0;

// Walls block it. ON by default because a dynamic light without the shadowmap
// has no occlusion at all -- with the reach this one has, it lit the room on
// the far side of the wall you were facing and the monster behind the door.
// The cost is one shadowmap row, and the shadow edge of a light held in a hand
// trails the hand by a frame. Needs gl_light_shadowmap on to do anything.
user bool  rsfl_spot_shadows = true;

// ------------------------------------------------------------------- dust --
// Sampled in WORLD space, so motes hang in the room rather than travelling
// with the torch -- sweeping the beam reveals different dust, the way it should.
user float rsfl_dust        = 0.45;
user float rsfl_dust_scale  = 0.035;   // higher = finer motes
// Map units a second. One noise cell is 1 / rsfl_dust_scale units (about 29 at
// the default), so anything much under 5 reads as dust hanging still.
user float rsfl_dust_drift  = 0.35;

// Deterministic, never random() -- the RNG seed is in the netgame consistency
// checksum and a wobble is not worth spending it on.
user float rsfl_flicker     = 0.08;

// ----------------------------------------------------------------- colour --
user int   rsfl_r           = 255;
user int   rsfl_g           = 244;
user int   rsfl_b           = 214;

// ================= Radiance =================
// The Look picker and the switches on the top page. Display preferences for
// this machine, so nosave like RS_Bloom's.
nosave int   rsr_look           = 0;
nosave int   rsr_look_applied   = 0;
nosave int   rsr_bloom_pending  = -1;
nosave bool  rsr_reactive       = false;
nosave int   rsr_reactive_applied = -1;
nosave bool  rsr_rand_map       = false;
nosave bool  rsr_rand_death     = false;
// Glow brightness on the top page: multiplies every lane's intensity.
server float gitd_master        = 1.0;
// Radiance's live multiplier on the glow throb (Low Power's bursts). Local.
nosave float gitd_pulse_mod     = 1.0;
