// RS_Radiance -- six effects, one mod.

// ================= RS_Darkness =================
// RS_Darkness -- CVars
//
// Darkness as a shader term rather than a per-sector rewrite.
//
// DarkDoomZ walks every sector and overwrites Sector.LightLevel, which means
// it holds a backup array to undo itself, destroys Lighting thinkers rather
// than fight them for the same field, and can only ever be uniform wall to
// wall inside one sector. This drives Level.SetDarkness instead: same four
// curves, same constants, evaluated against each fragment's own light. It
// writes nothing to the map, so there is nothing to undo and nothing to fight.

// ---------------------------------------------------------------- master --
server bool  rsd_enabled   = true;
server int   rsd_preset    = 4;          // Horizon -- distance, the thing a sector cannot do.
                                         // Must match RSD_Presets.DEFAULT.

// ----------------------------------------------------------------- curve --
// 0 off, 1 subtract, 2 compress, 3 cap brightest, 4 deepen shadows.
// Transcribed from DarkDoomZ, which took them from the original DarkDoom.
server int   rsd_mode      = 1;

// How hard, in Doom's 0-255 light units. 96/128/256 are Lite/Classic/Black.
server float rsd_adjust    = 128.0;

// Internal. What RS_Sweeps' darkness effect adds on top of rsd_adjust while a
// sweep is acting, in the same light units; 0 when no sweep is acting. The
// push adds it to the Amount and clamps the sum to 0-256.
// NOSAVE, NOT SERVER. RS_Sweeps used to move rsd_adjust itself: one server
// write per crossed sector per tic, each queued to the network, all reading
// the same not-yet-updated value, and the last one saved to the ini as the
// player's own Amount. This is local, immediate, and never the player's
// setting. It still persists in the ini like any nosave cvar, so the handler
// resets it to 0 whenever a map starts or a save is loaded.
nosave float rsd_sweep_offset = 0.0;

// A floor under the result. MUST be 0 for the Dark preset to reach true
// black -- any value here is light that survives everything.
server float rsd_minlight  = 0.0;

// Lifts before the curve / after it.
server float rsd_pregain   = 0.0;
server float rsd_postgain  = 0.0;

// ------------------------------------------------------------- distance --
// Darkness deepening with range from the eye. A sector cannot express this at
// all -- it is the term that makes a dark room read as having depth rather
// than as the brightness slider having gone down.
// depth 0 = off, 1 = fully black at range.
server float rsd_dist        = 0.0;
server float rsd_dist_range  = 1024.0;   // map units to reach full depth

// --------------------------------------------------------------- height --
// Dark pooling below a reference height, or rising as a tide. Above the
// reference nothing changes.
server float rsd_height       = 0.0;
server float rsd_height_range = 256.0;   // units past ref to reach full depth

// Which side of the reference the dark pools on: 0 below, 1 above.
//
// Below is a cellar and is what this has always done. Above is a ceiling that swallows the
// light while the floor still burns, which is what Hellscape is built on and what the height
// term could not express at all until the engine learned the direction.
server int   rsd_height_dir   = 0;

// 0 fixed at rsd_height_z, 1 follows the player's feet.
server int   rsd_height_mode  = 0;
server float rsd_height_z     = 0.0;

// WHERE THE REFERENCE SITS RELATIVE TO YOU, in follow mode.
//
// The shader darkens only BELOW the reference. Following your feet therefore
// does almost nothing on flat ground -- the floor is at your feet, so it is
// not below them -- and the pool could only ever appear in geometry you were
// standing above. Undertow advertised wading to waist height and could not
// produce it.
//
// Offsetting the reference upward puts the top of the pool where the preset
// actually wants it: about 48 for waist, 64 for over your head. Negative
// values push it below you, so only what you climb down into goes dark.
server float rsd_height_offset = 0.0;

// The reference the shader actually gets is not a cvar. The push reads these
// three every tic and from UiTick, so the sliders move it while the menu is
// open. In follow mode the push hands the offset to the engine
// (Level.SetDarknessHeightFollow) and the renderer adds it to the camera's
// interpolated Z each frame, so the pool edge rides lifts and stairs smoothly
// and stays per-client: it is where YOUR view is, never the host.

// Internal. The preset index last applied, so a preset only re-applies when
// it CHANGES -- not on every map load, which used to wipe slider tweaks.
// NOSAVE, NOT SERVER. RS_GlowInTheDark's cvarinfo documents this failure at
// length: a server cvar is not written locally when you set it, so a latch
// read back on the next tic still reads its old value and the whole preset
// re-applies -- more cvar writes, which delays the round trip further, which
// causes more passes. GlowInTheDark compounded it until the tic's net buffer
// overflowed. This mod writes 12 to 19 cvars per apply rather than fifty-four
// so it has not hit that cliff, but it is the same defect.
//
// A savegame restores the server cvars but not this, so the handler keeps a
// copy with the save and puts the latch back to match on load.
nosave int   rsd_preset_applied = -1;

// HOW MUCH OF THE DARKNESS ACTORS ARE SPARED, 0 to 1.
//
// The darkening applies to the whole scene, which takes the monsters with it.
// At 0 a room dark enough to make the glow worth having is a room where a
// thing walking towards you simply is not there. 1 leaves actors at full
// brightness, which reads as cut out and pasted on.
//
// 0.4 keeps them readable as shapes without lifting them out of the room.
server float rsd_actor_spare = 0.4;

// ================= RS_GlowInTheDark =================
// GlowInTheDark 2.0 -- CVars
//
// Archived (no "noarchive"), unlike 1.1, so your settings survive a restart.
//
// Four lanes:
//   wf  wall above the floor seam      Sector.SetGlowColor(Sector.floor)
//   wc  wall below the ceiling seam    Sector.SetGlowColor(Sector.ceiling)
//   fg  the floor's own face           Sector.SetFlatGlowColor(Sector.floor)
//   cg  the ceiling's own face         Sector.SetFlatGlowColor(Sector.ceiling)
//
// Reach means different axes per system and this is easy to trip over:
// *_reach on wf/wc is VERTICAL along the wall; on fg/cg it is HORIZONTAL,
// inward from the nearest edge. Same name in the engine too (GlowHeight vs
// FlatGlowHeight) -- see Sector.SetGlowHeight and Sector.SetFlatGlowHeight in
// mapdata.zs.

// ---------------------------------------------------------------- master --
server bool  gitd_enabled      = true;
server int   gitd_preset       = 1;

// SURFACE TEXTURE, CHOSEN SEPARATELY FROM THE PRESET.
//
// The grain, the scanlines and the cracks used to belong to whichever preset
// included them, which made the best-looking part of the effect the hardest to
// reach -- the tight traces existed only inside Circuitry and the crazed
// cracks only inside Spore.
//
// 0 leaves whatever the preset chose, which is exactly the old behaviour and
// is the default. Anything else lands on top of whatever palette is underneath.
server int   gitd_texture      = 0;
server bool  gitd_shuffle      = false;
server int   gitd_ondeath      = 0;       // 0 off, 1 new colours, 2 new preset

// Seamless corners. The wall lane and the flat lane meeting at a corner agree
// on one colour at the line they share, and a lane on an auto far colour ramps
// away to its own -- so the join becomes a continuous ramp instead of a
// visible edge. This is exactly what GlowColorFar exists for -- see
// Sector.SetGlowColorFar in wadsrc/static/zscript/mapdata.zs. On by default;
// an explicitly picked far colour on a lane still overrides it.
server bool  gitd_seamless     = true;
// Seamless corners WHILE A WAVE RUNS (owner 2026-09-18: the wall and ceiling
// join is not seamless). Seamless corners switch themselves off whenever a
// glow wave is live, because a wave moves each surface's reach independently
// and the join it had just closed reopens -- and eight of the presets run
// waves, so the owner meets the seam on most of them.
//
// On, the corner colour agreement is kept under a wave AND the flat lane takes
// its wall neighbour's phase (the ceiling face takes the wall-from-ceiling
// phase, the floor face takes the wall-from-floor one), so the two sides of a
// join beat together instead of half a cycle apart.
//
// ON by default as of 2026-09-20. It shipped off because the engine seeded a
// wall's wave from the plane height and a flat's from its first linedef, so the
// two sides of a join could not match even with the colour agreed -- this row
// could only remove the hue step. Engine 406a1ab05f gives all four lanes ONE
// per-sector seed, so the join now closes properly and there is no longer a
// reason to leave the seam open by default.
//
// The cost, stated plainly: it overrides a preset's own phase offsets, so a
// preset that deliberately climbs the room (Reactor, Signal) stops climbing.
// Switch it off to get that back.
//
// It closes the join completely as of engine 406a1ab05f (2026-09-18): all four
// lanes now hash ONE per-sector number, so the wave's brightness and the glow
// grain match across a corner instead of differing by the seed. Before that
// this row could only remove the hue step.
server bool  gitd_seamless_wave = true;

// EMERGENCY LIGHTING, for RS_Ballistics' shot-out lights. Once this share of
// a room's light fixtures is destroyed, that room's lanes lean to the
// emergency colour and come up in intensity.
//
// On by default, and inert without RS_Ballistics: nothing reports a dead
// fixture, so no room ever reaches the threshold.
//
// 0.75 rather than 1.0 so one lamp left alive in an awkward corner does not
// hold the whole room back from reacting.
server bool  gitd_emergency       = true;
server float gitd_emergency_share = 0.75;
server float gitd_emergency_gain  = 1.35;
server color gitd_emergency_color = "C81E14";

// FIRE LIGHT, for RS_Ballistics' flamethrower. A room that is burning lifts
// its own glow warm and bright, and falls back as the fire dies -- their
// flamethrower lights a room while you pour, but burning floor holds no light
// of its own, so a corridor used to go dark behind you with fire still on it.
//
// The FALL is theirs (rsb_firelight_linger): this follows their share rather
// than running a fade of its own.
//
// Inert without RS_Ballistics, and presentation only -- no sector light is
// written by either side, and their fire is client-side anyway.
server bool  gitd_firelight       = true;
server float gitd_firelight_mix   = 0.7;
server float gitd_firelight_gain  = 1.8;
server color gitd_firelight_color = "FF7A1E";
// Seamless corners, shape too. Off by default: the floor and ceiling faces
// take the wall lane's reach, falloff and intensity at a corner as well as its
// colour, so the two ramps match in width and curve. On, the Floor Face and
// Ceiling Face shape sliders stop doing anything wherever a wall lane meets
// them -- which is why it is not the default any more.
server bool  gitd_seamless_shape = false;

// Seamless WALLS. Corners fix the join inside one sector; this fixes the join
// BETWEEN sectors -- the hard vertical line down a wall where a red room meets
// a blue one, and the hard edge across a floor where two sectors of the same
// room carry different colours. A Doom room is nearly always several sectors,
// so without this every step, ledge and doorway is a colour break.
// Blend 0 = each sector keeps its own colour; 1 = a sector takes its
// neighbours' average outright.
server bool  gitd_seamless_walls = true;
server float gitd_wall_blend      = 0.5;


// ---------------------------------------------------------------- inset --
// HOW FAR IN FROM THE SEAM A LANE STARTS. Engine bb9bd1ba56, asked for by the
// owner on 2026-09-20: "bio has a harsh cut where it hits the seams. can we
// have it fade OUT before it hits the seams, like other ones fade IN from
// them?"
//
// Every glow in this family is brightest AT the plane and fades away from it,
// so a preset that lights the flats and not the walls puts a surface at full
// brightness hard against an unlit one and the join is a cut. An inset makes
// the lane climb from dark at the seam to full over this distance, and only
// then start its falloff -- a floor that glows in its middle and lets the
// corners go dark.
//
// Map units, the same quantity as the reach, and the shader clamps it to the
// reach so a lane cannot be inverted by overshooting. 0 is exactly the old
// curve, which is why every preset that does not ask for one is unchanged.
server float gitd_wf_inset     = 0.0;
server float gitd_wc_inset     = 0.0;
server float gitd_fg_inset     = 0.0;
server float gitd_cg_inset     = 0.0;
server float gitd_liq_inset    = 0.0;

// ------------------------------------------------------------ randomiser --
// Governs every policy, not just the random one: fixed colour aside, all
// colour sources land in HSV and get clamped into these windows.
server int   gitd_seed         = 1337;
server float gitd_hue_min      = 0.0;
server float gitd_hue_max      = 360.0;
server float gitd_sat_min      = 0.35;
server float gitd_sat_max      = 0.85;
server float gitd_val_min      = 0.45;
server float gitd_val_max      = 1.0;
server bool  gitd_lock_planes  = false;   // floor and ceiling share a colour
server bool  gitd_light_invert = true;    // light policy: dark rooms glow more

// ------------------------------------------------- lane: wall from floor --
// policy: 0 fixed, 1 random per sector, 2 texture hash, 3 light level
// falloff: 0 linear, 1 quadratic, 2 sqrt, 3 exponential
// far:     0 off, 1 auto-derived, 2 explicit
server bool  gitd_wf_on        = true;
server int   gitd_wf_policy    = 1;
server color gitd_wf_color     = "808080";
server float gitd_wf_reach     = 64.0;
server int   gitd_wf_falloff   = 0;
server float gitd_wf_intensity = 1.0;
server int   gitd_wf_far       = 1;
server color gitd_wf_farcolor  = "000000";

// ----------------------------------------------- lane: wall from ceiling --
server bool  gitd_wc_on        = true;
server int   gitd_wc_policy    = 1;
server color gitd_wc_color     = "808080";
server float gitd_wc_reach     = 64.0;
server int   gitd_wc_falloff   = 0;
server float gitd_wc_intensity = 1.0;
server int   gitd_wc_far       = 1;
server color gitd_wc_farcolor  = "000000";

// -------------------------------------------------- lane: floor own face --
server bool  gitd_fg_on        = true;
server int   gitd_fg_policy    = 1;
server color gitd_fg_color     = "808080";
server float gitd_fg_reach     = 96.0;
server int   gitd_fg_falloff   = 0;
server float gitd_fg_intensity = 1.0;
server int   gitd_fg_far       = 1;
server color gitd_fg_farcolor  = "000000";

// ------------------------------------------------ lane: ceiling own face --
server bool  gitd_cg_on        = true;
server int   gitd_cg_policy    = 1;
server color gitd_cg_color     = "808080";
server float gitd_cg_reach     = 96.0;
server int   gitd_cg_falloff   = 0;
server float gitd_cg_intensity = 1.0;
server int   gitd_cg_far       = 1;
server color gitd_cg_farcolor  = "000000";

// --------------------------------------------------------------- liquids --
// Sectors whose floor is a liquid override the fg lane. TerrainDef.IsLiquid
// decides first; the stock Doom liquid flats (NUKAGE, FWATER, SWATER, LAVA,
// BLOOD, SLIME01-12, RROCK05-08) are matched by name after it, because the
// engine's terrain.txt has no Doom floors at all. This is the
// replacement for 1.1's gldefs.bm, and it does what GLDEFS could not: lights
// the liquid's own surface rather than only the wall beside it.
server bool  gitd_liq_on        = true;
server int   gitd_liq_policy    = 0;
server color gitd_liq_color     = "40ff40";
server float gitd_liq_reach     = 160.0;
server int   gitd_liq_falloff   = 2;
server float gitd_liq_intensity = 1.4;
server int   gitd_liq_far        = 1;
server color gitd_liq_farcolor   = "000000";
server bool  gitd_liq_walls     = true;   // also push it up the wall (wf lane)

// ------------------------------------------------------------------ wave --
// Per-pixel peaks and valleys along a glow. Wavelength 0 = off.
server float gitd_wave_len       = 0.0;
// ONE DIAL OVER ALL THE MOTION. Every animated part of the glow -- the wave
// travelling along a lane, the flow crawling down it, the cells blinking --
// has its own speed, and a preset sets all three to suit its own look. This
// scales whatever the preset chose, so "I like this preset but it is too
// busy" is one slider rather than three, and the preset's balance between the
// three is preserved instead of being flattened.
//
// 1.0 is the preset exactly as authored.
server float gitd_speed          = 1.0;

server float gitd_wave_speed     = 1.0;
server float gitd_wave_sharp     = 1.0;
server int   gitd_wave_shape     = 1;
server float gitd_wave_reach     = 0.0;
server float gitd_wave_bright    = 0.0;
server float gitd_wave_colour    = 0.0;
server float gitd_wave_detune    = 0.0;
server float gitd_wave_seed      = 0.0;
server float gitd_wave_ph_wtop   = 0.0;
server float gitd_wave_ph_wbot   = 0.0;
server float gitd_wave_ph_floor  = 0.0;
server float gitd_wave_ph_ceil   = 0.0;
server int   gitd_wave_origin    = 0;     // 0 static at map centre, 1 follows you (see PushWaveOrigin)

// -------------------------------------------------------- surface detail --
// Texture INSIDE the lit area. None of these move a glow's shape.
server float gitd_tex_noise     = 0.0;
server float gitd_tex_scale     = 0.06;
server float gitd_tex_drift     = 0.0;
server float gitd_tex_contrast  = 1.0;

server float gitd_flow          = 0.0;
server float gitd_flow_spacing  = 1.0;
server float gitd_flow_speed    = 1.0;
server float gitd_flow_sharp    = 1.0;

server float gitd_cell          = 0.0;
server float gitd_cell_scale    = 1.0;
server float gitd_cell_speed    = 1.0;
server float gitd_cell_width    = 0.5;

// react is a strength dial on the engine's fog-disturbance array, which this
// mod does not populate -- it will do nothing on its own. pulse/level are the
// self-contained "room's own alarm" and are what the throbbing presets use.
// See SetGlowReact in vmthunks.cpp and mGlowTex4 in hw_viewpointuniforms.h.
server float gitd_react         = 0.0;
server float gitd_pulse         = 0.0;
server float gitd_pulse_level   = 0.0;
// HOW FAST IT BEATS, separately from how hard. The engine derives the throb
// rate from the LEVEL, so asking for a bright alarm used to force a fast one
// -- RedAlert beat about twice a second at nearly full depth, which is a
// strobe rather than a pulse. 1.0 is the old rate.
server float gitd_pulse_rate    = 1.0;

// Internal. The preset index last applied, so a preset only re-applies when
// it CHANGES -- not on every map load, which used to wipe slider tweaks.
//
// NOSAVE, NOT SERVER, and the distinction is load-bearing. A server cvar is
// not written locally when you set it: the write is queued to the network and
// the value only appears after it round-trips through tic processing. This is
// read back one tic later by SyncPreset as an "already applied" flag, so as a
// server cvar it still reads -1 on the next tic and the whole preset re-applies
// -- eighty to a hundred and ten more cvar writes, which delays the round trip
// further, which causes more passes. It compounded until the tic's net buffer
// overflowed and the game died with "Attempted to write past end of stream".
//
// nosave (CVAR_CONFIG_ONLY) keeps the one property this actually needs -- it
// survives the handler being rebuilt per map -- while writing immediately and
// never touching the wire. Nothing else should ever see this value.
//
// Because it is not in the savegame, WorldLoaded re-latches both of these from
// the restored gitd_preset and gitd_texture when a save loads.
nosave int   gitd_preset_applied = -1;
// Same reasoning as gitd_preset_applied above -- nosave, not server.
nosave int   gitd_texture_applied = -2;

// ================= RS_Fog =================
// RS_Fog -- CVars
//
// A body of mist with a real world-space ceiling: stand knee deep in it and
// look down at its surface. Analytic, not raymarched, which is why it is
// affordable at 90Hz per eye.
//
// The engine had every one of these knobs and no way to reach them -- no
// on/off, no menu, and nothing connecting the fog to anything happening in the
// game. This is that.

// ---------------------------------------------------------------- master --
server bool  rsf_enabled     = true;
server int   rsf_preset      = 1;

// Internal: the preset last applied, so a preset only re-applies when it
// CHANGES rather than on every map load, which would wipe slider tweaks.
//
// NOSAVE, NOT SERVER, and the distinction is load-bearing. A server cvar is not
// written locally when you set it: the write is queued to the network and only
// lands once that tic's commands run. WorldTick and then UiTick both read the
// latch before it lands, so each re-applied the whole preset -- about sixty
// server writes, again every tic until the first one arrived. That is the
// pattern that overflowed the net buffer ("Attempted to write past end of
// stream") in RS_GlowInTheDark. Same fix as RS_Sweeps, RS_Darkness and GitD.
nosave int   rsf_preset_applied = -1;

// Internal: whether the standing fog was pushed while enabled, so switching the
// mod off clears the slab ONCE instead of every tic. Clearing every tic erased
// anyone else's slab for as long as the fog stayed off.
nosave int   rsf_standing_pushed = 0;

// ------------------------------------------------------------------ body --
server float rsf_top         = 56.0;    // how high the mist reaches
server float rsf_density     = 0.45;    // 0 = off
server float rsf_soft        = 28.0;    // how soft the top edge is
server float rsf_scatter     = 1.0;     // how much the flashlight lights it

// How many dynamic lights light the mist: rockets, plasma, explosions, lamps. 0 is off and
// is how it has always been -- the fog took light from the flashlight and from short-lived
// disturbances and from nothing else, so a projectile flew down a black corridor lighting
// the walls and leaving the mist it was inside dark.
//
// IT COSTS. The fog reads every one of these per pixel of mist, so this is a count and not a
// strength: 4 is cheap, 8 is the cap. Turn it down before turning other things off if the
// frame time suffers.
server int   rsf_dynlights   = 0;

// Which reference the edges follow. 0 = a fixed world height. Above 0, the top
// and bottom are heights ABOVE THE FLOOR YOU STAND ON, so the depth underfoot
// is the same on any floor. The number is how closely the fog tracks OTHER
// floors: at 1 every step shows, at 0.35 a step ten units up raises the fog
// three, so a staircase reads as a slope rather than a flight of steps.
server float rsf_follow      = 0.35;

// The layer's bottom, measured the same way as the top. Far below 0 is fog all
// the way down; above 0 lifts it into a floating band.
server float rsf_bottom      = -256.0;
// A stacked, rolling bottom. No menu row; presets reset both to 0.
server float rsf_bottom_period = 0.0;
server float rsf_bottom_roll = 0.0;

// --------------------------------------------------------------- surface --
// A flat top reads as a sheet the moment you can see it clearly. Two waves at
// an angle interfere, and interference is what stops it looking like machinery.
server float rsf_surf_amp    = 8.0;
server float rsf_surf_len    = 288.0;
server float rsf_surf_speed  = 0.7;
server float rsf_surf_cross  = 0.6;

// ----------------------------------------------------------------- churn --
server float rsf_noise_scale = 0.010;
server float rsf_noise_depth = 0.40;
server float rsf_drift_x     = 2.5;
server float rsf_drift_y     = 1.2;

// -------------------------------------------------------------- tendrils --
// Wisps standing up out of the surface. Density 0 = none.
server float rsf_tend_density = 0.0;
server float rsf_tend_spacing = 160.0;
server float rsf_tend_radius  = 22.0;
server float rsf_tend_height  = 96.0;
server float rsf_tend_rise    = 0.5;
server float rsf_tend_spread  = 0.4;
server float rsf_tend_lean    = 0.2;
server float rsf_tend_taper   = 0.7;

// ---------------------------------------------------------------- colour --
server int   rsf_col_r       = 168;
server int   rsf_col_g       = 176;
server int   rsf_col_b       = 190;

// A second colour mixed through it, for mist that is not one flat tone.
server int   rsf_grad_r      = 90;
server int   rsf_grad_g      = 110;
server int   rsf_grad_b      = 92;
server float rsf_grad_mix    = 0.0;

// How much colour the mist takes from the room's own glow. Turn it up and the
// fog goes whatever colour the lighting is.
server float rsf_pickup      = 0.55;

// A TRANSIENT TINT another mod lays over the second colour -- RS_Sweeps' fog
// tint effect, while a sweep band is washing over the mist. Mix 0 means no
// override and the gradient above is used as normal.
//
// It exists because two callers shared one engine gradient: RS_Sweeps set it
// from WorldTick and this mod's UiTick push put rsf_grad straight back before
// a frame was drawn, so the sweep's colour never showed. Now the writer sets
// these and this mod pushes them in place of its own.
//
// NOSAVE: local, immediate, never on the wire. Zeroed when a map loads or
// unloads, because a nosave value persists in the ini and a tint left behind
// by a sweep that never finished would otherwise stick.
nosave int   rsf_tint_r      = 0;
nosave int   rsf_tint_g      = 0;
nosave int   rsf_tint_b      = 0;
nosave float rsf_tint_mix    = 0.0;

// ------------------------------------------------------------------ wake --
// One lagging point that thins the mist where you just walked. Its size,
// strength and stretch are pushed with the standing fog, so they move while the
// menu is open; only its position comes from the playsim.
server bool  rsf_wake        = true;
server float rsf_wake_radius = 56.0;
server float rsf_wake_strength = 0.8;
server float rsf_wake_stretch = 1.6;

// ---------------------------------------------------------------- waders --
// Monsters shouldering the mist aside as they move.
//
// THROTTLED HARD on purpose. There are 32 disturbance slots, recycled oldest
// first, so thirty monsters each pushing one every tic means every slot is a
// tenth of a second old and nothing lives long enough to read as a wake. One
// pick per window: the nearest moving monster that did not go last time.
server bool  rsf_waders      = true;
server int   rsf_wader_every = 6;       // tics between picks
server float rsf_wader_range = 1024.0;  // how far out to bother looking

// ---------------------------------------------------------------- events --
// A ring travelling outward from something that just died.
server bool  rsf_death_ripple = true;
server float rsf_death_strength = 0.8;
server float rsf_death_speed  = 220.0;
server float rsf_death_life   = 0.9;

// An explosion LIGHTS the mist rather than clearing it. This is the one
// disturbance mode that adds light and no density, so it shows even where there
// is no mist -- the Off preset included. Switching the mod off stops it.
server bool  rsf_ignite      = true;
server int   rsf_ignite_min  = 20;      // minimum radius damage to count
server float rsf_ignite_radius = 192.0;
server float rsf_ignite_strength = 1.0;
server float rsf_ignite_speed = 320.0;
server float rsf_ignite_life = 0.5;
// The flash's own colour. It used to be the second fog colour, which most
// presets leave black, so explosions added black light and nothing showed.
server int   rsf_ignite_r    = 255;
server int   rsf_ignite_g    = 150;
server int   rsf_ignite_b    = 70;

// A sweep band (RS_Sweeps) pushing the mist ahead of its front and leaving it
// thin behind. 0 lets sweeps pass through the fog without touching it.
server float rsf_bow         = 0.0;
server float rsf_bow_width   = 48.0;
